# Files stored here by old Kirjuri versions are case attachments. get_file.php serves them after the
# login and case access checks; they must never be served directly.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
