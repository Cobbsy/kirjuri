{% extends 'base.twig' %} {% block title %}
<title>{{ lang.help }} - {{ settings.title_text }}</title>
{% endblock title %}
{% block content %}
<div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
  <div class="page-title-row">
    <h1 class="h3">{{ lang.help }}</h1>
    <span class="text-muted">Kirjuri {{ release_version }}</span>
  </div>
  <p class="help-lead">{{ lang.help_intro }}</p>
  {% set sections = [
      {'icon': 'plus', 'title': lang.help_requests_title, 'text': [lang.help_requests_text]},
      {'icon': 'hdd-o', 'title': lang.help_devices_title, 'text': [lang.help_devices_text]},
      {'icon': 'play', 'title': lang.help_statuses_title, 'text': [lang.help_statuses_text]},
      {'icon': 'file-text-o', 'title': lang.help_report_title, 'text': [lang.help_report_text]},
      {'icon': 'search', 'title': lang.help_search_title, 'text': [lang.help_search_text, lang.search_hint]},
      {'icon': 'users', 'title': lang.help_access_title, 'text': [lang.help_access_text]},
      {'icon': 'mobile', 'title': lang.help_two_factor_title, 'text': [lang.help_two_factor_text]},
      {'icon': 'envelope-o', 'title': lang.help_messages_title, 'text': [lang.help_messages_text]},
    ] %}
  <div class="help-grid">
    {% for section in sections %}
    <section class="card">
      <h2 class="card-header"><i class="fa fa-{{ section.icon }}" aria-hidden="true"></i> {{ section.title }}</h2>
      <div class="card-body">
        {% for paragraph in section.text %}<p>{{ paragraph }}</p>{% endfor %}
      </div>
    </section>
    {% endfor %}
    <section class="card">
      <h2 class="card-header"><i class="fa fa-balance-scale" aria-hidden="true"></i> {{ lang.licenses }}</h2>
      <div class="card-body">
        <p>{{ lang.help_licenses_text }}</p>
        <a class="btn btn-default" href="licenses.php"><i class="fa fa-balance-scale" aria-hidden="true"></i> {{ lang.licenses }}</a>
      </div>
    </section>
  </div>
</div>
{% endblock %}
