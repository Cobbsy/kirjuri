{% extends 'base.twig' %}
{% block title %}
<title>{{ lang.log_in }} - {{ settings.title_text }}</title>
{% endblock title %}
{% block bodytag %}
<body class="app login-page">
{% endblock bodytag %}
{% block logo %}
{% endblock logo %}
{% block navi %}
{% endblock navi %}
{% block content %}
<main class="login-shell">
  <div class="login-card">
    <div class="login-brand">
      <span class="brand-mark" aria-hidden="true"><i class="fa fa-search"></i></span>
      <div>
        <div class="login-brand-name">Kirjuri</div>
        <div class="login-brand-sub">{% if settings.title_text and settings.title_text != "Kirjuri" %}{{ settings.title_text }} &middot; {% endif %}{{ settings.release }}</div>
      </div>
    </div>
    <h1 class="h3">{{ lang.log_in }}</h1>

    {% if session.message.type == "error" %}
    <div class="alert alert-danger" role="alert"><i class="fa fa-warning" aria-hidden="true"></i> {{ session.message.content }}</div>
    {% elseif session.message.type == "info" %}
    <div class="alert alert-success" role="status"><i class="fa fa-check-circle" aria-hidden="true"></i> {{ session.message.content }}</div>
    {% endif %}

    {% if settings.motd %}
    <div class="alert alert-warning">
      <i class="fa fa-warning" aria-hidden="true"></i> {{ settings.motd|purify }}
    </div>
    {% endif %}

    <form role="form" method="post" action="submit.php?type=login">
      <input type="hidden" name="token" value="{{session.user.token}}">
      <div class="form-group">
        <label for="username" class="control-label">{{ lang.username }}</label>
        <input type="text" class="form-control" id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
      </div>

      <div class="form-group">
        <label for="password" class="control-label">{{ lang.password }}</label>
        <input type="password" class="form-control" id="password" name="password" maxlength="64" autocomplete="current-password">
      </div>
      {% if settings.enable_ldap_authentication == "1" %}
      <div class="form-group">
        <select class="form-control" name="auth_type" id="auth_type" aria-label="Domain / Local">
          <option value="ldap" selected>Domain</option>
          <option value="local">Local</option>
        </select>
      </div>
      {% else %}
      <input type="hidden" name="auth_type" value="local">
      {% endif %}

      <button type="submit" class="btn btn-primary btn-block btn-lg" id="request_save_button"><i class="fa fa-sign-in"></i> {{ lang.log_in }}</button>
      {% for user in session.all_users %}
        {% if (user.id == 1) and ("I" not in user.flags) %}
        <a href="submit.php?type=anon_login" class="btn btn-default btn-block">{{ lang.anon_login_button }}</a>
        {% endif %}
      {% endfor %}
    </form>
  </div>
</main>
{% endblock %}
{% block layout_end %}
{% endblock layout_end %}
