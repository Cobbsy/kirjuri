{% extends 'base.twig' %}
{% block title %}
<title>{{ lang.log_in }} - {{ settings.title_text }}</title>
{% endblock title %}
{% block bodytag %}
<body class="app login-page">
{% endblock bodytag %}
{% block logo %}
{% endblock logo %}
{% block navi %}
{% endblock navi %}
{% block content %}
<main class="login-shell">
  <div class="login-card">
    <div class="login-brand">
      <span class="brand-mark" aria-hidden="true"><i class="fa fa-search"></i></span>
      <div>
        <div class="login-brand-name">Kirjuri</div>
        <div class="login-brand-sub">{% if settings.title_text and settings.title_text != "Kirjuri" %}{{ settings.title_text }} &middot; {% endif %}{{ settings.release }}</div>
      </div>
    </div>
    <h1 class="h3">{% if two_factor %}{{ lang.two_factor }}{% else %}{{ lang.log_in }}{% endif %}</h1>

    {% if session.message.type == "error" %}
    <div class="alert alert-danger" role="alert"><i class="fa fa-warning" aria-hidden="true"></i> {{ session.message.content }}</div>
    {% elseif session.message.type == "info" %}
    <div class="alert alert-success" role="status"><i class="fa fa-check-circle" aria-hidden="true"></i> {{ session.message.content }}</div>
    {% endif %}

    {% if two_factor and two_factor.mode == "code" %}
    {# The second step after the right password: a code from the app, or a recovery code. #}
    <form role="form" method="post" action="submit.php?type=two_factor_code" class="two-factor-form">
      <input type="hidden" name="token" value="{{ two_factor.token }}">
      <p>{{ lang.two_factor_enter_code }}</p>
      <div class="form-group">
        <label for="two_factor_code" class="control-label">{{ lang.two_factor_code }}</label>
        <input type="text" class="form-control two-factor-code-input" id="two_factor_code" name="two_factor_code" inputmode="numeric" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" maxlength="7" autofocus>
      </div>
      <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fa fa-sign-in" aria-hidden="true"></i> {{ lang.log_in }}</button>
    </form>
    <details class="two-factor-recovery">
      <summary>{{ lang.two_factor_use_recovery_code }}</summary>
      <form role="form" method="post" action="submit.php?type=two_factor_code">
        <input type="hidden" name="token" value="{{ two_factor.token }}">
        <div class="form-group">
          <label for="recovery_code" class="control-label">{{ lang.two_factor_recovery_code }}</label>
          <input type="text" class="form-control" id="recovery_code" name="recovery_code" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="32" aria-describedby="recovery_code_hint">
          <span class="field-hint" id="recovery_code_hint">{{ lang.two_factor_recovery_hint }}</span>
        </div>
        <button type="submit" class="btn btn-default btn-block">{{ lang.log_in }}</button>
      </form>
    </details>
    <form method="post" action="submit.php?type=two_factor_cancel" class="two-factor-cancel">
      <input type="hidden" name="token" value="{{ two_factor.token }}">
      <button type="submit" class="btn btn-link">{{ lang.two_factor_cancel }}</button>
    </form>

    {% elseif two_factor and two_factor.mode == "setup" %}
    {# Two-factor sign-in is required for this account, which does not have it yet: set it up before signing in. #}
    <p>{{ lang.two_factor_setup_required }}</p>
    <form role="form" method="post" action="submit.php?type=two_factor_enrol" class="two-factor-form" data-validate novalidate>
      <input type="hidden" name="token" value="{{ two_factor.token }}">
      {% include 'two_factor_setup.twig' with {setup: two_factor.setup, prefix: 'enrol_'} %}
      <button type="submit" class="btn btn-primary btn-block btn-lg"><i class="fa fa-check" aria-hidden="true"></i> {{ lang.two_factor_turn_on }}</button>
    </form>
    <form method="post" action="submit.php?type=two_factor_cancel" class="two-factor-cancel">
      <input type="hidden" name="token" value="{{ two_factor.token }}">
      <button type="submit" class="btn btn-link">{{ lang.two_factor_cancel }}</button>
    </form>

    {% else %}
    {% if settings.motd %}
    <div class="alert alert-warning">
      <i class="fa fa-warning" aria-hidden="true"></i> {{ settings.motd|purify }}
    </div>
    {% endif %}

    <form role="form" method="post" action="submit.php?type=login">
      <input type="hidden" name="token" value="{{session.user.token}}">
      <div class="form-group">
        <label for="username" class="control-label">{{ lang.username }}</label>
        <input type="text" class="form-control" id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
      </div>

      <div class="form-group">
        <label for="password" class="control-label">{{ lang.password }}</label>
        <input type="password" class="form-control" id="password" name="password" maxlength="64" autocomplete="current-password">
      </div>
      {% if settings.enable_ldap_authentication == "1" %}
      <div class="form-group">
        <select class="form-control" name="auth_type" id="auth_type" aria-label="Domain / Local">
          <option value="ldap" selected>Domain</option>
          <option value="local">Local</option>
        </select>
      </div>
      {% else %}
      <input type="hidden" name="auth_type" value="local">
      {% endif %}

      <button type="submit" class="btn btn-primary btn-block btn-lg" id="request_save_button"><i class="fa fa-sign-in"></i> {{ lang.log_in }}</button>
      {% for user in session.all_users %}
        {% if (user.id == 1) and ("I" not in user.flags) %}
        <a href="submit.php?type=anon_login" class="btn btn-default btn-block">{{ lang.anon_login_button }}</a>
        {% endif %}
      {% endfor %}
    </form>
    {% endif %}
  </div>
</main>
{% endblock %}
{% block layout_end %}
{% endblock layout_end %}
