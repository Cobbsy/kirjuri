{% extends 'base.twig' %}
{% block title %}
<title>{{ lang.messages|capitalize }}- {{ settings.title_text }}</title>
{% endblock title %}
{% block content %}
{% import _self as m %}
<div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
<div class="page-title-row">
  <h1 class="h3">{{ lang.messages|capitalize }}</h1>
  {% if show != "compose" %}<a class="btn btn-primary" href="messages.php?show=compose"><i class="fa fa-send" aria-hidden="true"></i> {{ lang.send_a_message }}</a>{% endif %}
</div>

{% if show == "compose" %}
<form class="card form-section form-sections" role="form" method="post" action="submit.php?type=send_message">
  <input type="hidden" name="token" value="{{session.user.token}}">
  <div class="card-header"><i class="fa fa-send" aria-hidden="true"></i> {{ lang.send_a_message }}</div>
  <div class="card-body field-grid">
    <div class="field">
      <label for="msgto">{{ lang.to }}</label>
      {% if open > 0 %}
      <select class="form-control" id="msgto" name="msgto">
        {% for msg in messages %}{% if msg.id == open %}<option value="{{ msg.msgfrom }}">{{ msg.msgfrom }}</option>{% endif %}{% endfor %}
      </select>
      {% else %}
      <select class="form-control" id="msgto" name="msgto">
        <option value="" {% if not prefill_msgto %}selected{% endif %} disabled>{{ lang.choose_recipient }}</option>
        {% for user in session.all_users|filter(user => user.username != session.user.username) %}
        <option value="{{ user.username }}"{% if prefill_msgto == user.name %} selected{% endif %}>{{ user.name }}</option>
        {% endfor %}
        <option disabled>---</option>
        <option value="ALL_USERS">{{ lang.send_to_all }}</option>
        <option value="{{ session.user.username }}">{{ lang.send_to_self }}</option>
      </select>
      {% endif %}
    </div>
    <div class="field field-span-2">
      <label for="subject">{{ lang.subject }}</label>
      <input type="text" class="form-control" id="subject" name="subject" value="{% if post %}{{ post.copy_subject }}{% endif %}{% for msg in messages %}{% if msg.id == open %}{{ lang.re }}{{ msg.subject }}{% endif %}{% endfor %}{{ session.post_cache.subject}}">
    </div>
    <div class="field field-wide">
      <textarea rows="25" name="body" aria-label="{{ lang.send_a_message }}">{% if post %}{{ post.copy_body }}{% endif %}{% for msg in messages %}{% if (msg.id == open) %}<br><br><p>---- From {{ msg.msgfrom }} {{ msg.attr_1 }}:</p>{{msg.body}}{% endif %}{% endfor %}{{ session.post_cache.body}}</textarea>
    </div>
  </div>
  <div class="card-footer">
    <a href="messages.php?show=compose" class="btn btn-default">{{ lang.clear_form }}</a>
    <button type="submit" class="btn btn-primary card-footer-end"><i class="fa fa-send" aria-hidden="true"></i> {{ lang.send }}</button>
  </div>
</form>
{% endif %}

{% if not show or show == "inbox" %}
<section class="card" id="inbox">
  <div class="card-header"><a href="messages.php?show=inbox"><i class="fa fa-inbox" aria-hidden="true"></i> {{ lang.inbox }}{% if session.unread.msgcount_to > 0 %} ({{ session.unread.msgcount_to }}){% endif %}</a></div>
  <div class="table-responsive">
  <table class="table message-table">
    <thead>
      <tr>
      <th>{{ lang.from }}</th>
      <th>{{ lang.subject }}</th>
      <th>{{ lang.sent }}</th>
      <th>{{ lang.received }}</th>
      <th></th>
      </tr>
    </thead>
    <tbody>
    {% for msg in messages %}
    {% if msg.archived_to == 0 and msg.msgto == session.user.username %}
    <tr {% if open == msg.id %}class="info"{% elseif not msg.received %}class="success"{% endif %}>
      <td>{{ m.sender(msg, session) }}</td>
      <td><a href="messages.php?open={{ msg.id }}&show=inbox">{% if not msg.subject %}<i>{{ lang.no_subject }}</i>{% else %}{{ msg.subject }}{% endif %}</a></td>
      <td class="text-nowrap">{{ msg.attr_1 }}</td>
      <td class="text-nowrap">{% if msg.received == "0" %}<i>{{ lang.new }}</i>{% else %}{{ msg.received }}{% endif %}</td>
      <td>{% if msg.received != "0" %}<a href="submit.php?type=archive_received&id={{msg.id}}" data-post aria-label="{{ lang.archive_message }}"><i class="fa fa-archive"></i></a>{% endif %}</td>
    </tr>
    {% if open == msg.id %}
    <tr>
      <td class="message-body" colspan="5">
        <div class="rich-text">{{ msg.body|purify }}</div>
        <form class="message-reply" role="form" method="post" action="submit.php?type=send_message">
          <input type="hidden" name="token" value="{{session.user.token}}">
          <input type="hidden" name="msgto" value="{{ msg.msgfrom }}">
          <div class="field">
            <label for="reply_subject">{{ lang.subject }}</label>
            <input type="text" class="form-control" id="reply_subject" name="subject" value="{{ lang.re }}{{ msg.subject }}">
          </div>
          <textarea rows="20" name="body" aria-label="{{ lang.reply }}">
                  <br><br><pre>---- {{ lang.original_message }} ----
{{ lang.from }}: {% for entry in session.all_users %}{% if entry.username == msg.msgfrom %}{{ entry.name }}{% endif %}{% endfor %} ({{ msg.msgfrom }})
{{ lang.to }}: {% for entry in session.all_users %}{% if entry.username == msg.msgto %}{{ entry.name }}{% endif %}{% endfor %} ({{ msg.msgto }})
{{ lang.sent_date }}: {{ msg.attr_1 }}
{{ lang.subject }}: {{msg.subject }}</pre>
                  {{msg.body}}</textarea>
          <div class="message-actions">
            <a class="btn btn-default" href="submit.php?type=archive_received&id={{msg.id}}" data-post><i class="fa fa-archive" aria-hidden="true"></i> {{ lang.archive_message }}</a>
            <button type="submit" class="btn btn-primary"><i class="fa fa-reply" aria-hidden="true"></i> {{ lang.reply }}</button>
          </div>
        </form>
      </td>
    </tr>
    {% endif %}
    {% endif %}
    {% endfor %}
    {% if session.unread.msgcount_to == 0 %}<tr><td colspan="5" class="text-muted">{{ lang.no_messages|capitalize }}</td></tr>{% endif %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

{% if not show or show == "outbox" %}
<section class="card" id="outbox">
  <div class="card-header"><a href="messages.php?show=outbox"><i class="fa fa-paper-plane-o" aria-hidden="true"></i> {{ lang.outbox }}{% if session.unread.msgcount_from > 0 %} ({{ session.unread.msgcount_from }}){% endif %}</a></div>
  <div class="table-responsive">
  <table class="table message-table">
    <thead>
      <tr>
      <th>{{ lang.from }}</th>
      <th>{{ lang.to }}</th>
      <th>{{ lang.subject }}</th>
      <th>{{ lang.sent }}</th>
      <th>{{ lang.received }}</th>
      <th></th>
      </tr>
    </thead>
    <tbody>
    {% for msg in messages %}
    {% if msg.archived_from == "0" and msg.msgfrom == session.user.username %}
    <tr {% if open == msg.id %}class="info"{% elseif not msg.received %}class="warning"{% endif %}>
      <td>{{ m.sender(msg, session) }}</td>
      <td>{% for entry in session.all_users %}{% if entry.username == msg.msgto %}{{ entry.name }}{% endif %}{% endfor %}</td>
      <td><a href="messages.php?open={{ msg.id }}&show=outbox">{% if not msg.subject %}<i>{{ lang.no_subject }}</i>{% else %}{{ msg.subject }}{% endif %}</a></td>
      <td class="text-nowrap">{{ msg.attr_1 }}</td>
      <td class="text-nowrap">{% if msg.received == "0" %}<i>{{ lang.not_received }}</i>{% else %}{{ msg.received }}{% endif %}</td>
      <td><a href="submit.php?type=archive_sent&id={{msg.id}}" data-post aria-label="{{ lang.archive_message }}"><i class="fa fa-archive"></i></a></td>
    </tr>
    {% if open == msg.id %}
    <tr>
      <td class="message-body" colspan="6">
        <div class="rich-text">{{ msg.body|purify }}</div>
        <form class="message-actions" method="post" action="messages.php?show=compose">
          <input type="hidden" name="token" value="{{session.user.token}}">
          <input type="hidden" value="{{msg.body}}" name="copy_body">
          <input type="hidden" value="{{msg.subject}}" name="copy_subject">
          <input type="hidden" value="{{msg.msgto}}" name="copy_msgto">
          <a class="btn btn-default" href="submit.php?type=archive_sent&id={{msg.id}}" data-post><i class="fa fa-archive" aria-hidden="true"></i> {{ lang.archive_message }}</a>
          <button type="submit" class="btn btn-primary"><i class="fa fa-copy" aria-hidden="true"></i> {{ lang.copy_to_new }}</button>
        </form>
      </td>
    </tr>
    {% endif %}
    {% endif %}
    {% endfor %}
    {% if session.unread.msgcount_from == 0 %}<tr><td colspan="6" class="text-muted">{{ lang.no_messages|capitalize }}</td></tr>{% endif %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

{% if not show or show == "archive" %}
<section class="card" id="archive">
  <div class="card-header card-header-split">
    <a href="messages.php?show=archive"><i class="fa fa-archive" aria-hidden="true"></i> {{ lang.archived }}{% if session.unread.msgcount_archived > 0 %} ({{ session.unread.msgcount_archived }}){% endif %}</a>
    {% if session.unread.msgcount_archived > 0 %}<a class="text-danger" href="submit.php?type=delete_all" data-post><i class="fa fa-remove" aria-hidden="true"></i> {{ lang.delete_all_archived }}</a>{% endif %}
  </div>
  <div class="table-responsive">
  <table class="table message-table">
    <thead>
      <tr>
      <th>{{ lang.from }}</th>
      <th>{{ lang.to }}</th>
      <th>{{ lang.subject }}</th>
      <th>{{ lang.sent }}</th>
      <th>{{ lang.received }}</th>
      <th></th>
      <th></th>
      </tr>
    </thead>
    <tbody>
    {% for msg in messages %}
    {% if (msg.archived_to == 1 and msg.msgto == session.user.username) or (msg.archived_from == 1 and msg.msgfrom == session.user.username) %}
    {% if (msg.deleted_to == 0 and msg.msgto == session.user.username) or (msg.deleted_from == 0 and msg.msgfrom == session.user.username) %}
    <tr {% if open == msg.id %}class="info"{% elseif not msg.received %}class="warning"{% endif %}>
      <td>{{ m.sender(msg, session) }}</td>
      <td>{% for entry in session.all_users %}{% if entry.username == msg.msgto %}{{ entry.name }}{% endif %}{% endfor %}</td>
      <td><a href="messages.php?open={{ msg.id }}&show=archive">{% if not msg.subject %}<i>{{ lang.no_subject }}</i>{% else %}{{ msg.subject }}{% endif %}</a></td>
      <td class="text-nowrap">{{ msg.attr_1 }}</td>
      <td class="text-nowrap">{% if msg.received == "0" %}<i>{{ lang.not_received }}</i>{% else %}{{ msg.received }}{% endif %}</td>
      <td>
      {% if msg.archived_to == "1" %}
      <a href="submit.php?type=restore_received&id={{msg.id}}" data-post aria-label="{{ lang.restore_to_inbox }}"><i class="fa fa-undo"></i></a>
      {% elseif msg.archived_from == "1" %}
      <a href="submit.php?type=restore_sent&id={{msg.id}}" data-post aria-label="{{ lang.restore_to_outbox }}"><i class="fa fa-undo"></i></a>
      {% endif %}
      </td>
      <td>
      {% if msg.msgto == session.user.username %}
      <a href="submit.php?type=delete_received&id={{msg.id}}" data-post aria-label="{{ lang.delete_message }}"><i class="fa fa-remove text-danger"></i></a>
      {% elseif msg.msgfrom == session.user.username %}
      <a href="submit.php?type=delete_sent&id={{msg.id}}" data-post aria-label="{{ lang.delete_message }}"><i class="fa fa-remove text-danger"></i></a>
      {% endif %}
      </td>
    </tr>
    {% if open == msg.id %}
    <tr>
      <td class="message-body" colspan="7">
        <div class="rich-text">{{ msg.body|purify }}</div>
        <form class="message-actions" method="post" action="messages.php?show=compose">
          <input type="hidden" name="token" value="{{session.user.token}}">
          <input type="hidden" value="{{msg.body}}" name="copy_body">
          <input type="hidden" value="{{msg.subject}}" name="copy_subject">
          <input type="hidden" value="{{msg.msgto}}" name="copy_msgto">
          {% if msg.msgto == session.user.username %}
          <a class="btn btn-default" href="submit.php?type=delete_received&id={{msg.id}}" data-post><i class="fa fa-remove" aria-hidden="true"></i> {{ lang.delete_message }}</a>
          {% elseif msg.msgfrom == session.user.username %}
          <a class="btn btn-default" href="submit.php?type=delete_sent&id={{msg.id}}" data-post><i class="fa fa-remove" aria-hidden="true"></i> {{ lang.delete_message }}</a>
          {% endif %}
          {% if msg.archived_to == "1" %}
          <a class="btn btn-default" href="submit.php?type=restore_received&id={{msg.id}}" data-post><i class="fa fa-undo" aria-hidden="true"></i> {{ lang.restore_to_inbox }}</a>
          {% elseif msg.archived_from == "1" %}
          <a class="btn btn-default" href="submit.php?type=restore_sent&id={{msg.id}}" data-post><i class="fa fa-undo" aria-hidden="true"></i> {{ lang.restore_to_outbox }}</a>
          {% endif %}
          <button type="submit" class="btn btn-primary"><i class="fa fa-copy" aria-hidden="true"></i> {{ lang.copy_to_new }}</button>
        </form>
      </td>
    </tr>
    {% endif %}
    {% endif %}
    {% endif %}
    {% endfor %}
    {% if session.unread.msgcount_archived == 0 %}<tr><td colspan="7" class="text-muted">{{ lang.no_messages|capitalize }}</td></tr>{% endif %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

</div>
{% endblock %}

{# Who sent a message, with an arrow into or out of the inbox. #}
{% macro sender(msg, session) %}
{% if msg.msgfrom == "Myself" %}<span class="text-success"><i class="fa fa-caret-right"></i> <i class="fa fa-inbox"></i></span> <i>{{ session.user.name }}</i>{% elseif msg.msgfrom == session.user.username %}<span class="text-danger"><i class="fa fa-inbox"></i> <i class="fa fa-caret-right"></i></span> {% for entry in session.all_users %}{% if entry.username == msg.msgfrom %}{{ entry.name }}{% endif %}{% endfor %}{% else %}<span class="text-success"><i class="fa fa-caret-right"></i> <i class="fa fa-inbox"></i></span> {% for entry in session.all_users %}{% if entry.username == msg.msgfrom %}{{ entry.name }}{% endif %}{% endfor %}{% endif %}
{% endmacro %}
