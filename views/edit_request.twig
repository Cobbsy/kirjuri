{% extends 'base.twig' %}
{% macro bytesToSize(bytes) %}
    {%- set kilobyte = 1024 -%}
    {%- set megabyte = kilobyte * 1024 -%}
    {%- set gigabyte = megabyte * 1024 -%}
    {%- set terabyte = gigabyte * 1024 -%}
    {%- if bytes < kilobyte -%}
        {{ bytes ~ ' B' }}
    {%- elseif bytes < megabyte -%}
        {{ (bytes / kilobyte)|number_format(2, '.') ~ ' KB' }}
    {%- elseif bytes < gigabyte -%}
        {{ (bytes / megabyte)|number_format(2, '.') ~ ' MB' }}
    {%- elseif bytes < terabyte -%}
        {{ (bytes / gigabyte)|number_format(2, '.') ~ ' GB' }}
    {%- else -%}
        {{ (bytes / terabyte)|number_format(2, '.') ~ ' TB' }}
    {%- endif -%}
{% endmacro %}
{% import _self as filesize_calc %}
{% block title %}
<!-- bytesToSize macro by Chausser from Stack Exchange: http://stackoverflow.com/questions/15280310/readable-file-sizes-with-the-twig-templating-system -->
<title>{{caserow.0.case_id}}/{{ caserow.0.case_added_date|date("Y") }} {{ lang.edit_request }} - {{ settings.title_text }}</title>
{% endblock title %}
{% block content %}

<!-- http://stackoverflow.com/questions/1009808/enter-key-press-behaves-like-a-tab-in-javascript -->

<script>
$('body').on('keydown', 'input, select, textarea', function(e) {
var self = $(this)
  , form = self.parents('form:eq(0)')
  , focusable
  , next
  , prev
  ;

if (e.shiftKey) {
 if (e.keyCode == 13) {
     focusable =   form.find('input,a,select,button,textarea').filter(':visible');
     prev = focusable.eq(focusable.index(this)-1);

     if (prev.length) {
        prev.focus();
     } else {
        form.submit();
    }
  }
}
  else
if (e.keyCode == 13) {
    focusable = form.find('input,a,select,button,textarea').filter(':visible');
    next = focusable.eq(focusable.index(this)+1);
    if (next.length) {
        next.focus();
    } else {
        form.submit();
    }
    return false;
}
});

$(function() {
  var availableTags = [{{ confCrimes|raw }}];
  $("#case_crime").autocomplete({
    source: availableTags
  });
});

</script>

{% for entry in caserow %}
<div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
  <ol class="breadcrumb">
    <li><a href="index.php?year={{ caserow.0.case_added_date|date("Y") }}">{{ lang.front_page }} {{ caserow.0.case_added_date|date("Y") }}</a></li>
    <li>{{ caserow.0.case_id }}/{{ caserow.0.case_added_date|date("Y") }} {{ caserow.0.case_name }} {{ caserow.0.case_file_number }}</li>
  </ol>
  <div>
    <!-- Tab panes -->
    <div class="tab-content">
      <div role="tabpanel" class="tab-pane{% if not returntab %} active{% endif %}" id="tab-exam-request">
        {% if ((not entry.forensic_investigator) and (not entry.phone_investigator)) and (entry.case_status <="2" )%}
        <script type="text/javascript">
          $(document).ready(function() { $('#add_forensic_examiner_modal').modal('show'); });
        </script>
        <div class="modal fade" id="add_forensic_examiner_modal" role="dialog" aria-labelledby="myModalLabel">
          <div class="modal-dialog" role="document">
            <div class="modal-content">
              <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">{{ lang.new_examination_request }} {{ entry.case_id }}/{{ entry.case_added_date|date("Y") }}</h4>
              </div>
              <div class="modal-body">
                <b>{{ lang.no_examiner_assigned }}</b>
                <p>{{ lang.pick_examiner }}</p>
                <form name="add_forensic_investigator" class="form" role="form" method="post" action="submit.php?type=case_update&uid={{ entry.parent_id }}">
                  <input type="hidden" name="token" value="{{session.user.token}}">
                  <input type="hidden" name="ct" value="{{ct}}">
                  <div class="form-group">
                    <select style="text-align:left;width:100%;" class="btn btn-default" name="forensic_investigator" id="forensic_investigator">
                      <option disabled>{{ lang.forensic_examiner_long }}</option>
                      {% for user in session.all_users %}
                        {% if 'F' in user.flags == true %}
                          <option value="{{ user.name }}" {% if user.name == session.user.name %}selected{% endif %}>{{ user.name }} ({{user.username}})</option>
                        {% endif %}
                      {% endfor %}
                      <option value="-">* {{ lang.mobile_examination_only }}</option>
                    </select>
                  </div>
                  {% if entry.case_contains_mob_dev == "1" %}
                  <b>{{ lang.request_contains_mobile_devices }}</b>
                  <p>{{ lang.pick_mobile_examiner }}</p>
                  <div class="form-group">
                    <input type="hidden" name="phone_investigator" value="">
                    <select style="text-align:left;width:100%;" class="btn btn-default" name="phone_investigator" id="phone_investigator">
                      <option selected disabled>{{ lang.mobile_examiner_long }}</option>

                      {% for user in session.all_users %}
                        {% if 'M' in user.flags == true %}
                          <option value="{{ user.name }}" {% if user.name == session.user.name %}selected{% endif %}>{{ user.name }} ({{user.username}})</option>
                        {% endif %}
                      {% endfor %}
                      <option value="-">* {{ lang.no_mobile_examination }}</option>
                    </select>
                  </div>
                  {% endif %}
              </div>
              <div class="modal-footer">
              <button type="button" class="btn btn-default" data-dismiss="modal">{{ lang.close }}</button>
              {% if entry.case_status == "1" %}
              <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> {{ lang.save }}</button>
              {% elseif entry.case_status == "2" %}
              <button type="submit" class="btn btn-success"><i class="fa fa-save"></i> {{ lang.update }}</button>
              {% endif %}
              <input type="hidden" name="case_request_description" value="{{ entry.case_request_description }}">
              <input type="hidden" name="case_crime" value="{{ entry.case_crime }}">
              <input type="hidden" name="classification" value="{{ entry.classification }}">
              <input type="hidden" name="case_file_number" value="{{ entry.case_file_number }}">
              <input type="hidden" name="case_urgency" value="{{ entry.case_urgency }}">
              <input type="hidden" name="case_investigator" value="{{ entry.case_investigator }}">
              <input type="hidden" name="case_investigation_lead" value="{{ entry.case_investigation_lead }}">
              <input type="hidden" name="case_investigator_tel" value="{{ entry.case_investigator_tel }}">
              <input type="hidden" name="case_investigator_unit" value="{{ entry.case_investigator_unit }}">
              <input type="hidden" name="case_confiscation_date" value="{{ entry.case_confiscation_date }}">
              <input type="hidden" name="case_suspect" value="{{ entry.case_suspect }}">
              <input type="hidden" name="case_name" value="{{ entry.case_name }}">
              <input type="hidden" name="case_contains_mob_dev" value="{{ entry.case_contains_mob_dev }}">
              </form>
              </div>
            </div>
          </div>
        </div>
        {% endif %}

        {% set progress_total = 0 %}
        {% set progress_done = 0 %}
        {% for device in mediarow %}
        {% set device_step = device.device_action|split('|') %}
        {% if (device_step.0 >= "1") and (device.is_removed != "1") %}
        {% set progress_total = progress_total + settings.device_action_count %}
        {% set progress_done = progress_done + device_step.0 %}
        {% endif %}
        {% endfor %}
        {% set current_request_progress = progress_done > 0 ? ((100 / progress_total) * progress_done)|round(0, "ceil") : 0 %}

        <div class="case-header">
          <div class="case-header-main">
            <div class="case-header-meta">
              <span class="case-number">{{ entry.case_id }}/{{ entry.case_added_date|date("Y") }}</span>
              {% if entry.case_status == "1" %}<span class="chip chip-new"><i class="fa fa-pause" aria-hidden="true"></i> {{ lang.new|capitalize }}</span>{% endif %}
              {% if entry.case_status == "2" %}<span class="chip chip-open"><i class="fa fa-play" aria-hidden="true"></i> {{ lang.open|capitalize }}</span>{% endif %}
              {% if entry.case_status == "3" %}<span class="chip chip-ready"><i class="fa fa-check" aria-hidden="true"></i> {{ lang.ready|capitalize }}</span>{% endif %}
              {% if entry.case_urgency == "1" and entry.case_status != "3" %}<span class="chip chip-urgent"><i class="fa fa-bolt" aria-hidden="true"></i> {{ lang.urgency_urgent }}</span>{% endif %}
              {% if entry.case_contains_mob_dev == "1" %}<span class="chip"><i class="fa fa-mobile" aria-hidden="true"></i> {{ lang.contains_mobile_devices }}</span>{% endif %}
              {% if entry.case_owner %}<span class="chip chip-locked" title="{{ entry.case_owner|replace({";": ", "}) }}"><i class="fa fa-lock" aria-hidden="true"></i> {{ lang.access_control }}</span>{% endif %}
            </div>
            <h1 id="examination_request" class="case-title">{% if entry.case_name %}{{ entry.case_name }}{% elseif entry.case_suspect %}{{ lang.suspect_abbrev }} {{ entry.case_suspect }}{% else %}{{ lang.suspect_short }}{% endif %}</h1>
            <div class="case-subtitle">{{ entry.case_file_number }} &middot; {{ entry.case_crime }} &middot; {{ entry.classification }}</div>
          </div>
          {% if entry.case_status != "3" and progress_done > 0 %}
          <div class="case-progress" title="{{ current_request_progress }}% {{ lang.devices_investigated }}">
            <div class="case-progress-label"><strong>{{ current_request_progress }}%</strong> {{ lang.devices_investigated }}</div>
            <div class="progress">
              <div class="progress-bar progress-bar-{% if current_request_progress <= 20 %}danger{% elseif current_request_progress <= 80 %}warning{% else %}success{% endif %}" role="progressbar" aria-valuenow="{{ current_request_progress }}" aria-valuemin="0" aria-valuemax="100" style="width:{{ current_request_progress }}%"></div>
            </div>
            <a class="case-progress-reload" href="edit_request.php?case={{ caserow.0.id }}"><i class="fa fa-refresh" aria-hidden="true"></i> {{ lang.reload_hint_link }}</a>
          </div>
          {% endif %}
        </div>

        {% if samerequest_file_number %}
        <div class="alert alert-warning"><i class="fa fa-exclamation-triangle" aria-hidden="true"></i> <a href='index.php?search="{{ entry.case_file_number|url_encode }}"'>{{ lang.requests_with_matching_complaint_number }}</a>: {% for entry in samerequest_file_number %}<a href="edit_request.php?case={{ entry.id }}">{{ entry.case_id }}/{{ entry.case_added_date|date("Y") }}</a>{% if not loop.last%}, {% endif%}{% endfor %}</div>
        {% endif %}

        <form class="case-actions" role="form" method="post" action="submit.php?type=update_request_status">
          <input type="hidden" name="token" value="{{session.user.token}}">
          <input type="hidden" name="ct" value="{{ct}}">
          <input type="hidden" value="{{ entry.id }}" name="returnid">
          <div class="case-actions-group">
            {% if caserow.0.case_status != "3" %}<button type="button" class="btn btn-default" data-toggle="modal" data-target="#perustiedot"><i class="fa fa-pencil"></i> {{ lang.edit_request_details }}</button>{% endif %}
            <div class="btn-group" role="group">
              <a href="print_sticker.php?uid={{ entry.id }}&type=examination_request" target="_BLANK" class="btn btn-default"><i class="fa fa-print"></i> {{ lang.print_sticker }}</a>
              <a class="btn btn-default" href="case_report.php?case={{ entry.id }}" target="_BLANK"><i class="fa fa-file-text-o"></i> {{ lang.print_report }}</a>
            </div>
            <div class="btn-group" role="group">
              <a href="download_csv.php?case={{caserow.0.id}}" class="btn btn-default"><i class="fa fa-download"></i> {{ lang.download_csv }}</a>
              <a href="download_krf.php?case={{caserow.0.id}}" class="btn btn-default"><i class="fa fa-download"></i> KRF</a>
            </div>
          </div>
          <div class="case-actions-primary">
            {% set progress_counter1 = "0" %}
            {% set progress_counter2 = "0" %}
            {% if not mediarow %}
            <input type="hidden" value="1" name="case_status">
            <button type="submit" class="btn btn-danger"><i class="fa fa-undo"></i> {{ lang.dismiss_request }}</button>
            {% else %}
            {% for entry in mediarow %}
            {% set jutun_vaihe = entry.device_action|split('|') %}
            {% if (jutun_vaihe.0 >= "1") and (entry.is_removed != "1") %}
            {% set progress_counter1 = (progress_counter1 + settings.device_action_count) %}
            {% set progress_counter2 = (progress_counter2 + jutun_vaihe.0) %}
            {% endif%}
            {% if (loop.last == true) and (progress_counter1 == progress_counter2) %}
            {% for entry in caserow %}
            {% if entry.case_status == "2" %}
            <input type="hidden" value="3" name="case_status">
            <button type="submit" class="btn btn-success"><i class="fa fa-check"></i> {{ lang.close_ready_request }}</button>
            {% elseif entry.case_status == "3" %}
            <input type="hidden" value="2" name="case_status">
            <button type="submit" class="btn btn-default"><i class="fa fa-undo"></i> {{ lang.reopen_closed_request }}</button>
            {% endif %}
            {% endfor %}
            {% elseif (loop.last == true) and (progress_counter1 != progress_counter2) %}
            {% for entry in caserow %}
            {% if entry.case_status == "1" %}
            <input type="hidden" value="2" name="case_status">
            <button type="submit" class="btn btn-primary"><i class="fa fa-play"></i> {{ lang.start_investigation }}</button>
            {% endif %}
            {% endfor %}
            {% endif %}
            {% endfor %}
            {% endif%}
          </div>
        </form>

        <div class="case-grid">
          <section class="card case-facts">
            <dl>
              <div><dt>{{ lang.target|capitalize }}</dt><dd><a href='index.php?search="{{ entry.case_suspect|url_encode }}"'>{{ entry.case_suspect }}</a></dd></div>
              <div><dt>{{ lang.crime|capitalize }}</dt><dd>{{ entry.case_file_number }}, {{ entry.classification }}, {{ entry.case_crime }}</dd></div>
              <div><dt>{{ lang.head_of_investigation|capitalize }}</dt><dd><a href='index.php?search="{{ entry.case_investigation_lead|url_encode }}"'>{{ entry.case_investigation_lead }}</a> (<a href='index.php?search="{{ entry.case_investigator_unit|url_encode }}"'>{{ entry.case_investigator_unit }}</a>)</dd></div>
              <div><dt>{{ lang.investigator|capitalize }}</dt><dd><a href='index.php?search="{{ entry.case_investigator|url_encode }}"'>{{ entry.case_investigator }}</a>{% if entry.case_investigator_tel %}, <a href="tel:{{ entry.case_investigator_tel|replace({" ": ""}) }}">{{ entry.case_investigator_tel }}</a>{% endif %}</dd></div>
              <div><dt>{{ lang.forensic_examiner_long|capitalize }}</dt><dd>{% if entry.forensic_investigator %}<a href='index.php?search="{{ entry.forensic_investigator|url_encode }}"'>{{ entry.forensic_investigator }}</a>{% else %}<span class="text-alert">{{ lang.no_examiner_assigner }}</span>{% endif %}</dd></div>
              <div><dt>{{ lang.mobile_examiner_long|capitalize }}</dt><dd>{% if entry.phone_investigator %}<a href='index.php?search="{{ entry.phone_investigator|url_encode }}"'>{{ entry.phone_investigator }}</a>{% elseif entry.case_contains_mob_dev == "1" %}<span class="text-alert">{{ lang.no_examiner_assigner }}</span>{% else %}<span class="text-faint">&ndash;</span>{% endif %}</dd></div>
              {% if entry.case_owner %}
              <div class="case-facts-wide"><dt>{{ lang.access_control }}</dt><dd><i class="fa fa-lock" aria-hidden="true"></i> {{ entry.case_owner|replace({";": ", "}) }}</dd></div>
              {% endif %}
              <div class="case-facts-wide"><dt>{{ lang.evidence_description|capitalize }}</dt><dd>{{ entry.case_request_description }}</dd></div>
              <div class="case-facts-wide"><dt>{{ lang.request_details|capitalize }}</dt><dd>{{ entry.case_requested_action }}</dd></div>
            </dl>
          </section>

          <aside class="card case-dates">
            <dl>
              <div class="case-urgency"><dt>{{ lang.urgency|capitalize }}</dt><dd>{% if entry.case_urgency == "1" %}<strong class="text-alert">{{ lang.urgency_urgent }}</strong>{%endif %}{% if entry.case_urgency == "2" %}{{ lang.urgency_normal }}{%endif %}{% if entry.case_urgency == "3" %}{{ lang.urgency_can_wait }}{%endif %}{% if entry.case_urg_justification %}, <strong>{{ entry.case_urg_justification }}</strong>{% endif %}</dd></div>
              <div><dt>{{ lang.requested|capitalize }}</dt><dd>{{ entry.case_added_date|date("d.m.Y") }}</dd></div>
              <div><dt>{{ lang.confiscation_date|capitalize }}</dt><dd>{{ entry.case_confiscation_date|date("d.m.Y") }}</dd></div>
              <div><dt>{{ lang.latest_update|capitalize }}</dt><dd>{% if (entry.last_updated|date("U") < settings.stalled_case|date("U")) and (entry.case_status == "2")%}<span class="text-alert"><i class="fa fa-moon-o" aria-hidden="true"></i> {{ entry.last_updated|date("d.m.Y") }}</span>{% else %}{{ entry.last_updated|date("d.m.Y") }}{% endif %}</dd></div>
            </dl>
          </aside>
        </div>

        {% if attachment_files or filelist or ((settings.allow_attachments == "1") and (caserow.0.case_status == "2")) or ((failed_uploads is defined) and session.failed_uploads) %}
        <section class="card">
          <div class="card-header"><i class="fa fa-paperclip" aria-hidden="true"></i> {{ lang.attachments }}</div>
          {% if attachment_files or filelist %}
          <iframe name="dlframe" style="visibility:hidden;display:none;"></iframe>
          <table class="table attachment-table">
            <thead>
              <tr>
                <th>{{lang.header_filename}}</th>
                <th>{{lang.header_filetype}}</th>
                <th class="text-right">{{lang.header_filesize}}</th>
              </tr>
            </thead>
            <tbody>
            {% for file in attachment_files %}
            <tr>
              <td><a href="get_file.php?file={{ file.id }}" target="dlframe">
              {% if "image" in file.type %}
              <i class="fa fa-file-image-o"></i>
              {% elseif "audio" in file.type %}
              <i class="fa fa-file-audio-o"></i>
              {% elseif "pdf" in file.type %}
              <i class="fa fa-file-pdf-o"></i>
              {% elseif "text" in file.type %}
              <i class="fa fa-file-text-o"></i>
              {% elseif "officedocument.wordprocessing" in file.type %}
              <i class="fa fa-file-word-o"></i>
              {% elseif "officedocument.spreadsheet" in file.type %}
              <i class="fa fa-file-excel-o"></i>
              {% elseif "officedocument.presentation" in file.type %}
              <i class="fa fa-file-powerpoint-o"></i>
              {% elseif "zip" in file.type %}
              <i class="fa fa-file-zip-o"></i>
              {% else %}
              <i class="fa fa-file-o"></i>
              {% endif %}
              {{file.name}}</a></td>
              <td class="text-muted" style="width:1px;">{{file.type}}</td>
              <td class="text-right" style="width:1px;white-space:nowrap;">
                {{filesize_calc.bytesToSize(file.size)}}
                {% if (settings.allow_attachments == "1") and (caserow.0.case_status == "2") %}
                <a href="submit.php?type=remove_attachment&file={{ file.id }}" data-post data-ct="{{ ct }}" onclick="return confirm('{{lang.file_remove_confirm}}')" class="attachment-remove" aria-label="{{ lang.file_remove_confirm }}"><i class="fa fa-remove"></i></a>
                {% endif %}
              </td>
            </tr>
            {% endfor%}
            {% for file in filelist %}
            <tr>
              <td colspan="3">
                <i class="fa fa-file-o"></i> <a href="get_file.php?case={{ caserow.0.id }}&legacy={{ file.token }}">attachments/{{ caserow.0.id }}/{{ file.filename }}</a>
              </td>
            </tr>
            {% endfor %}
            </tbody>
          </table>
          {% endif %}
          {% if (settings.allow_attachments == "1") and (caserow.0.case_status == "2") %}
          <form class="attachment-upload" action="upload.php" method="post" enctype="multipart/form-data">
            <input type="hidden" name="case" value="{{caserow.0.id}}">
            <input type="hidden" name="token" value="{{session.user.token}}">
            <input type="hidden" name="ct" value="{{ct}}">
            <input type="file" multiple name="fileToUpload[]" id="fileToUpload">
            <button type="submit" class="btn btn-default btn-sm"><i class="fa fa-upload"></i> {{ lang.upload_attachment }}</button>
            <span class="attachment-limits">{{lang.max_attachment_size}} {{filesize_calc.bytesToSize(settings.max_attachment_size)}}, {{filesize_calc.bytesToSize(free_disk_space)}} {{ lang.free_space_left }}</span>
          </form>
          {% endif %}
          {% if failed_uploads is defined %}
          {% for failure in session.failed_uploads %}
          <div class="attachment-failure"><i class="fa fa-warning"></i> {{ failure }}</div>
          {% endfor %}
          {% endif %}
        </section>
        {% endif %}

        {% set visible_devices = mediarow|filter(device => device.is_removed != "1") %}
        {% if visible_devices|length > 0 %}
        <section class="card">
          <div class="card-header"><i class="fa fa-tasks" aria-hidden="true"></i> {{ lang.device_progress }}</div>
          <div class="device-progress-grid">
          {% for entry in visible_devices %}
          {% set jutun_vaihe = entry.device_action|split('|') %}
          {% set step_percent = jutun_vaihe.0 == "0" ? 100 : ((100 / settings.device_action_count) * jutun_vaihe.0)|round(0, "ceil") %}
          <a class="device-progress-item" href="device_memo.php?uid={{ entry.id }}" title="UID {{ entry.id }} {{ entry.device_type }} {{ entry.device_manuf }} {{ entry.device_model }}">
            <img src="views/img/svg/{% if entry.device_type %}{{ entry.device_type|lower|replace({" ": "_", "ä": "a", "ö": "o"}) }}{% else %}tuntematon{% endif %}.svg" alt="" width="32" height="32">
            <span class="device-progress-body">
              <span class="device-progress-name">{{ entry.device_type }} <span class="text-muted">{{ entry.device_manuf }} {{ entry.device_model }}</span></span>
              <span class="device-progress-status">{{ jutun_vaihe.1 }}</span>
              <span class="progress">
                <span class="progress-bar progress-bar-{% if settings.device_action_count == jutun_vaihe.0 %}success{% elseif jutun_vaihe.0 == "1" %}danger{% elseif jutun_vaihe.0 == "0" %}info{% else %}warning{% endif %}" role="progressbar" aria-valuenow="{{ step_percent }}" aria-valuemin="0" aria-valuemax="100" style="width:{{ step_percent }}%"></span>
              </span>
            </span>
          </a>
          {% endfor %}
          </div>
        </section>
        {% endif %}

        {% if caserow.0.report_notes %}
        <section class="card">
          <div class="card-header"><i class="fa fa-file-text-o" aria-hidden="true"></i> {{ lang.examination_report }}</div>
          <div class="card-body rich-text">{{ caserow.0.report_notes|purify }}</div>
        </section>
        {% endif %}
        {% if caserow.0.examiners_notes %}
        <section class="card">
          <div class="card-header"><i class="fa fa-pencil-square-o" aria-hidden="true"></i> {{ lang.examiners_private_notes }}</div>
          <div class="card-body rich-text">{{ caserow.0.examiners_notes|purify }}</div>
        </section>
        {% endif %}

        {% if (caserow.0.case_status == "1") and (not mediarow) %}
        <form method="POST" class="case-delete" action="submit.php?type=set_removed_case">
          <input type="hidden" name="token" value="{{session.user.token}}">
          <input type="hidden" name="ct" value="{{ct}}">
          <input type="hidden" name="remove_exam_request" value="{{ caserow.0.id }}">
          <button type="submit" class="btn btn-link btn-danger-link"><i class="fa fa-trash-o"></i> {{ lang.delete_request }}</button>
        </form>
        {% endif %}

      <!-- Modal -->
      <div class="modal fade" id="perustiedot" role="dialog" aria-labelledby="perustiedot">
        <div class="modal-dialog modal-lg" role="document">
          <div class="modal-content">
            <div class="modal-header">
