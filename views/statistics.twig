    {% set laskuri = "0" %}{% set monthBeginsAt = "01." ~ month_col ~ "." ~ dateStart|date("Y") %}{% set monthStopsAt = "31." ~ month_col ~ "." ~ dateStart|date("Y") ~ " 23:59.59" %}{% for entry in all_cases %}{% if (entry.case_added_date|date("U") >= monthBeginsAt|date("U")) and (entry.case_added_date|date("U") <= monthStopsAt|date("U")) %}
    {% if entry.case_urgency == "1"%}{% set laskuri = laskuri + 1 %}{% endif %}{% endif %}{% if loop.last == true %}
    <td>{% if laskuri >= "1" %}{{ laskuri }}{% else %}<span class="text-faint">{{ laskuri }}</span>{% endif %}</td>
    {% endif %}{% endfor %}
    {% else %}
    {% set laskuri = "0"%}
    {% for entry in all_cases %}
    {% if entry.case_urgency == "1"%}{% set laskuri = laskuri + 1 %}{% endif %}
    {% if loop.last == true %}
    <td><b>{% if laskuri >= "1" %}{{ laskuri }}{% else %}<span class="text-faint">{{ laskuri }}</span>{% endif %}</b></td>
    {% endif %}
    {% endfor %}
    {% endif %}
    {% endfor %}
  </tr>
</table>
  <canvas id="exam_requestChart" style="width:100%;height:400px;"></canvas>
  <ul class="chart-legend">
    <li><span class="chart-swatch chart-swatch-1" aria-hidden="true"></span>{{ lang.examination_requests }}</li>
    <li><span class="chart-swatch chart-swatch-2" aria-hidden="true"></span>{{ lang.examined_devices }}</li>
