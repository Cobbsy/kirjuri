    var ctx = document.getElementById("exam_requestChart").getContext("2d");
    var data = {
      labels: ["{{ lang.month_1 }}", "{{ lang.month_2 }}", "{{ lang.month_3 }}", "{{ lang.month_4 }}", "{{ lang.month_5 }}", "{{ lang.month_6 }}", "{{ lang.month_7 }}", "{{ lang.month_8 }}", "{{ lang.month_9 }}", "{{ lang.month_10 }}", "{{ lang.month_11 }}", "{{ lang.month_12 }}"],
      datasets: [
      {
        label: "{{ lang.examined_devices|e('js') }}",
        fillColor: translucent(chartColour[1], 0.08),
        strokeColor: chartColour[1],
        pointColor: chartColour[1],
        pointStrokeColor: surfaceColour,
        pointHighlightFill: surfaceColour,
        pointHighlightStroke: chartColour[1],
        data: [{% for month_col in 1..12 %}{% set laskuri = "0" %}{% set monthBeginsAt = "01." ~ month_col ~ "." ~ dateStart|date("Y") %}{% set monthStopsAt = "31." ~ month_col ~ "." ~ dateStart|date("Y") ~ " 23:59.59" %}{% for entry in all_cases %}{% if (entry.case_added_date|date("U") >= monthBeginsAt|date("U")) and (entry.case_added_date|date("U") <= monthStopsAt|date("U")) %}{% set laskuri = laskuri + entry.case_devicecount %}{% endif %}{% if loop.last == true %}{{ laskuri }}, {% endif %}{% endfor %}{% endfor %}]
      },
      {
        label: "{{ lang.examination_requests|e('js') }}",
        fillColor: translucent(chartColour[0], 0.08),
        strokeColor: chartColour[0],
        pointColor: chartColour[0],
        pointStrokeColor: surfaceColour,
        pointHighlightFill: surfaceColour,
        pointHighlightStroke: chartColour[0],
        data: [{% for month_col in 1..12 %}{% set laskuri = "0" %}{% set monthBeginsAt = "01." ~ month_col ~ "." ~ dateStart|date("Y") %}{% set monthStopsAt = "31." ~ month_col ~ "." ~ dateStart|date("Y") ~ " 23:59.59" %}{% for entry in all_cases %}{% if (entry.case_added_date|date("U") >= monthBeginsAt|date("U")) and (entry.case_added_date|date("U") <= monthStopsAt|date("U")) %}{% set laskuri = laskuri + 1 %}{% endif %}{% if loop.last == true %}{{ laskuri }}, {% endif %}{% endfor %}{% endfor %}]
      },
      {
        label: "{{ lang.urgent_requests|e('js') }}",
        fillColor: translucent(chartColour[2], 0.08),
        strokeColor: chartColour[2],
        pointColor: chartColour[2],
        pointStrokeColor: surfaceColour,
        pointHighlightFill: surfaceColour,
        pointHighlightStroke: chartColour[2],
        data: [{% for month_col in 1..12 %}{% set laskuri = "0" %}{% set monthBeginsAt = "01." ~ month_col ~ "." ~ dateStart|date("Y") %}{% set monthStopsAt = "31." ~ month_col ~ "." ~ dateStart|date("Y") ~ " 23:59.59" %}{% for entry in all_cases %}{% if (entry.case_added_date|date("U") >= monthBeginsAt|date("U")) and (entry.case_added_date|date("U") <= monthStopsAt|date("U")) %}{% if entry.case_urgency == "1"%}{% set laskuri = laskuri + 1 %}{% endif %}{% endif %}{% if loop.last == true %}{{ laskuri }}, {% endif %}{% endfor %}{% endfor %}]
      }
      ]
    };
    var myNewChart = new Chart(ctx).Line(data);
  </script>

