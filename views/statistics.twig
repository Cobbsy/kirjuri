{% extends 'base.twig' %} {% block title %}
<title>{{ lang.statistics }} - {{ settings.title_text }}</title>
{% endblock title %}
{% block content %}
<div class="col-sm-9 col-sm-offset-3
  col-md-10 col-md-offset-2 main">
<h1 class="page-header">{{ lang.statistics }} {{ dateStart|date("Y") }} <a href='statistics.php?year={{ (dateStart|date("Y") - 1 ) }}'><i class="fa fa-caret-left"></i></a> <a href='statistics.php?year={{ (dateStart|date("Y") + 1 ) }}'><i class="fa fa-caret-right"></i></a> </h1>
<script>
  // The charts draw on a canvas, so they take the theme's colours from its CSS variables.
  var themeStyle = getComputedStyle(document.documentElement);
  function themeColour(name) { return themeStyle.getPropertyValue(name).trim(); }
  Chart.defaults.global.scaleFontColor = themeColour("--k-text-muted");
  Chart.defaults.global.scaleLineColor = themeColour("--k-border-strong");
  Chart.defaults.Line.bezierCurve = false; // Straight lines between months: a curve would invent values.
  // Series colours: slots of the validated palette in kirjuri.css, in a fixed order.
  var chartColour = [1, 2, 3].map(function (n) { return themeColour("--k-chart-" + n); });
  var surfaceColour = themeColour("--k-surface");
  function translucent(colour, alpha) {
    var n = parseInt(colour.slice(1), 16);
    return "rgba(" + (n >> 16) + "," + ((n >> 8) & 255) + "," + (n & 255) + "," + alpha + ")";
  }
  Chart.defaults.Line.scaleGridLineColor = themeColour("--k-border");
  Chart.defaults.Bar.scaleGridLineColor = themeColour("--k-border");
  Chart.defaults.Radar.scaleLineColor = themeColour("--k-border");
  Chart.defaults.Radar.angleLineColor = themeColour("--k-border");
  Chart.defaults.Radar.pointLabelFontColor = themeColour("--k-text-muted");
</script>
{% import _self as charts %}
{% set request_total = count_new + count_open + count_finished %}
<div class="stat-cards">
  <section class="card">
    <div class="card-header">{{ lang.status_of_requests }}</div>
    <div class="card-body">
      {{ charts.bar_list([
        {label: lang.new|capitalize, count: count_new, class: 'bar-new'},
        {label: lang.open|capitalize, count: count_open, class: 'bar-open'},
        {label: lang.ready|capitalize, count: count_finished, class: 'bar-ready'},
      ]) }}
    </div>
  </section>
  <section class="card">
    <div class="card-header">{{ lang.requests_containing_phones }}</div>
    <div class="card-body">
      {% set phone_share = request_total > 0 ? (count_phones / request_total * 100)|round : 0 %}
      <p class="meter-figure"><b>{{ phone_share }} %</b> <span class="text-muted">{{ count_phones }} / {{ request_total }}</span></p>
      <div class="meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ phone_share }}" aria-label="{{ lang.requests_containing_phones }}"><span class="meter-fill" style="width:{{ phone_share }}%"></span></div>
    </div>
  </section>
  <section class="card">
    <div class="card-header">{{ lang.requests_by_classification }}</div>
    <div class="card-body">
      {% set rows = [] %}{% for label, count in cases_by_classification %}{% if count > 0 %}{% set rows = rows|merge([{label: label, count: count}]) %}{% endif %}{% endfor %}
      {{ charts.bar_list(rows|sort((a, b) => b.count <=> a.count)) }}
    </div>
  </section>
  <section class="card">
    <div class="card-header">{{ lang.requests_by_unit }}</div>
    <div class="card-body">
      {% set rows = [] %}{% for label, count in cases_by_unit %}{% if count > 0 %}{% set rows = rows|merge([{label: label, count: count}]) %}{% endif %}{% endfor %}
      {{ charts.bar_list(rows|sort((a, b) => b.count <=> a.count)) }}
    </div>
  </section>
</div>

<div class="col-md-12">
