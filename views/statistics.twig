{# Counts as labelled horizontal bars, longest first. rows: [{label, count, class}]; class picks a status colour. #}
{% macro bar_list(rows) %}
{% set most = max(rows|map(row => row.count)|merge([1])) %}
{% if rows is empty %}
<p class="text-muted">&ndash;</p>
{% else %}
<ul class="bar-list">
  {% for row in rows %}
  <li>
    <span class="bar-list-label">{{ row.label }}</span>
    <span class="bar-list-value">{{ row.count }}</span>
    <span class="bar-list-track" aria-hidden="true"><span class="bar-list-bar {{ row.class ?? '' }}{% if row.count == 0 %} is-zero{% endif %}" style="width:{{ (row.count / most * 100)|round(1) }}%"></span></span>
  </li>
  {% endfor %}
</ul>
{% endif %}
{% endmacro %}
