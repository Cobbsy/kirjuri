{% extends 'base.twig' %}
{% block title %}
<title>{{ lang.manage_users }} - {{ settings.title_text }}</title>
{% endblock title %}
{% block content %}
<script>
  $(document).ready(function (){
      // A user form is saved with the admin's own password; its Save button waits for that field.
      $("form.needs-password").each(function () {
          var form = $(this), password = form.find("[name=current_password]");
          var check = function () { form.find("[type=submit]").prop("disabled", password.val().length === 0); };
          password.on("input change", check);
          check();
      });
      {% for user in session.all_users %}
         $("#user_status_{{ user.username|replace({" ": "_"}) }}").load("user_status.php?user={{ user.username|url_encode }}");
      {% endfor %}
  });

  function autoRefreshStatus_div()
   {
    {% for user in session.all_users %}
       $("#user_status_{{ user.username|replace({" ": "_"}) }}").load("user_status.php?user={{ user.username|url_encode }}");
    {% endfor %}
   }
   setInterval('autoRefreshStatus_div()', 21000); // Refresh the unread counter

</script>
<div class="col-sm-9 col-sm-offset-3 col-md-10 col-md-offset-2 main">
  <div class="page-title-row">
    <h1 class="h3">{{ lang.user_management_header }}</h1>
    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#add_user_modal"><i class="fa fa-user-plus" aria-hidden="true"></i> {{ lang.add_a_new_local_user }}</button>
  </div>

  <div class="card">
  <div class="table-responsive">
  <table class="table table-striped">
    <thead>
      <tr>
      <th class="text-center"></th>
      <th>{{ lang.username|capitalize}}</th>
      <th>{{ lang.name|capitalize }}</th>
      <th>{{ lang.access_level|capitalize }}</th>
      <th class="text-center">LDAP</th>
      <th class="text-center">{{ lang.forensic_examiner_long|capitalize }}</th>
      <th class="text-center">{{ lang.mobile_examiner_long|capitalize }}</th>
      <th class="text-center">{{ lang.api_access|capitalize }}</th>
      <th class="text-center">{{ lang.ip_restrictions }}</th>
      <th class="text-center">{{ lang.active|capitalize }}</th>
      <th></th>
      </tr>
    </thead>
    <tbody>
    {% for user in session.all_users %}
    <tr {% if fields.id == user.id %}class="info"{% elseif 'I' in user.flags %}class="warning"{% endif %}>
      <td class="text-center"><div id="user_status_{{user.username|replace({" ": "_"}) }}"></div></td>
      <td><a href="users.php?populate={{user.id}}#u">{{ user.username }}</a>{% if session.user.username == user.username %} ({{ lang.logged_in|lower }}){% endif %}{% if 'I' in user.flags %} ({{ lang.flag_inactive|lower }}){% endif %}</td>
      <td>{{ user.name }}</td>
      <td>{% if user.access == 0 %}{{ lang.level_admin }}{% elseif user.access == 1 %}{{ lang.level_user }}{% elseif user.access == 2 %}{{ lang.level_viewonly }}{% elseif user.access == 3 %}{{ lang.level_addonly }}{% else %}???{% endif %}</td>
      <td class="text-center">{% if user.attr_3 == "LDAP_AUTH_ONLY" %}<i class="fa fa-check text-success"></i>{% else %}<i class="fa fa-remove icon-off"></i>{% endif %}</td>
      <td class="text-center">{% if 'F' in user.flags == true %}<i class="fa fa-check text-success"></i>{% else %}<i class="fa fa-remove icon-off"></i>{% endif %}</td>
      <td class="text-center">{% if 'M' in user.flags == true %}<i class="fa fa-check text-success"></i>{% else %}<i class="fa fa-remove icon-off"></i>{% endif %}</td>
      <td class="text-center">{% if 'A' in user.flags == true %}<i class="fa fa-check text-success"></i>{% else %}<i class="fa fa-remove icon-off"></i>{% endif %}</td>
      <td class="text-center">{% if user.attr_2|length > 26 %}<i class="fa fa-check text-success"></i>{% else %}<i class="fa fa-remove icon-off"></i>{% endif %}</td>
      <td class="text-center">{% if 'I' in user.flags == true %}<i class="fa fa-remove text-danger"></i>{% else %}<i class="fa fa-check text-success"></i>{% endif %}</td>
      <td class="text-nowrap"><a href="submit.php?type=force_logout&user={{user.username|url_encode}}" data-post><i class="fa fa-sign-out"></i> {{ lang.log_out }}</a></td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  </div>

{% if fields.id is not empty %}
<form class="card form-section needs-password" id="u" role="form" method="post" action="submit.php?type=create_user">
  <input type="hidden" name="token" value="{{session.user.token}}">
  <input type="hidden" name="user_id" value="{{fields.id}}">
  <div class="card-header"><i class="fa fa-edit" aria-hidden="true"></i> {{ fields.username }} [ID {{fields.id}}]</div>
  <div class="card-body">
    {% include 'user_fields.twig' with {prefix: 'edit_', user: fields} %}
  </div>
  <div class="card-footer">
    <button type="submit" class="btn btn-primary">{{ lang.save }}</button>
    <a href="users.php" class="btn btn-default">{{ lang.clear_form }}</a>
  </div>
</form>

{% if fields.sessions %}
<section class="card">
  <div class="card-header"><i class="fa fa-desktop" aria-hidden="true"></i> {{ lang.session_details }}</div>
  <div class="table-responsive">
  <table class="table">
    <thead>
      <tr>
        <th>{{ lang.session_file }}</th>
        <th>{{ lang.session_details }}</th>
        <th class="text-center">{{ lang.drop }}</th>
      </tr>
    </thead>
    <tbody>
    {% for session_file, session_content in fields.sessions %}
    <tr>
      <td>
        {{ session_file }}
        <p>{% if session_content.last_activity_sec <= "60" %}<span class="chip chip-ready">{{ lang.online }}</span>{% else %}<span class="chip">{{ lang.offline }}</span>{% endif %}</p>
      </td>
      <td>
        <p>{{ session_content.content }}</p>
        <p{% if session_content.last_activity_sec > "259200" %} class="text-danger"{% endif %}>{{ lang.last_activity }}: {{ session_content.last_activity }}</p>
      </td>
      <td class="text-center">
        <a href="submit.php?type=drop_session&user={{fields.username|url_encode}}&user_id={{ fields.id }}&session={{ session_file|replace({".txt": "", "session_": ""}) }}" data-post aria-label="{{ lang.drop }}"><i class="fa fa-times text-danger"></i></a>
      </td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}
{% endif %}

</div>

<div class="modal fade" id="add_user_modal" role="dialog" aria-labelledby="add_user_modal_title">
  <div class="modal-dialog" role="document">
    <form class="modal-content needs-password" role="form" method="post" action="submit.php?type=create_user">
      <input type="hidden" name="token" value="{{session.user.token}}">
      <input type="hidden" name="user_id" value="">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-label="{{ lang.close }}"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="add_user_modal_title">{{ lang.new_name_to_create }}</h4>
      </div>
      <div class="modal-body">
        {% include 'user_fields.twig' with {prefix: 'new_', user: {}} %}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-dismiss="modal">{{ lang.close }}</button>
        <button type="reset" class="btn btn-default">{{ lang.clear_form }}</button>
        <button type="submit" class="btn btn-primary">{{ lang.save }}</button>
      </div>
    </form>
  </div>
</div>
{% endblock %}
